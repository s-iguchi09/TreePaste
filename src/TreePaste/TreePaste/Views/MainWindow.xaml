<Window
    x:Class="TreePaste.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TreePaste.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TreePaste.Properties"
    xmlns:vm="clr-namespace:TreePaste.ViewModels"
    Title="TreePaste"
    Width="580"
    Height="640"
    FontFamily="Segoe UI Variable Text, Yu Gothic UI"
    FontSize="14"
    PreviewKeyDown="Window_PreviewKeyDown"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  パンくず・Flatten 用のトグルボタン（アクセントカラー + 角丸。押されている間は塗りつぶし）  -->
        <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorLight2BrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  見出しラベルと補足文（グレーの小さめの文字）  -->
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>

        <!--  Flatten は区別しやすいよう枠線を付ける  -->
        <Style
            x:Key="FlattenToggleStyle"
            BasedOn="{StaticResource SegmentToggleStyle}"
            TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Margin="16" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  コピー先パス  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{x:Static p:Strings.CopyToLabel}" />
                <Border
                    Margin="0,4,0,0"
                    Padding="10,6"
                    BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                    BorderThickness="0,0,0,2"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <SolidColorBrush Opacity="0.06" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
                    </Border.Background>
                    <TextBlock
                        Text="{Binding DestinationPathText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding DestinationPathText}" />
                </Border>
            </StackPanel>

            <!--  貼り付け方（パンくずで起点の階層を選ぶ / Flatten）  -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{x:Static p:Strings.PasteFromLabel}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                        Text="›"
                                        Visibility="{Binding HasSeparator, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ToggleButton
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Style="{StaticResource SegmentToggleStyle}"
                                        ToolTip="{x:Static p:Strings.SegmentToolTip}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Content="{x:Static p:Strings.FlattenButton}"
                        IsChecked="{Binding IsFlatten, Mode=TwoWay}"
                        Style="{StaticResource FlattenToggleStyle}"
                        ToolTip="{x:Static p:Strings.FlattenToolTip}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{Binding PreviewText}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  ラベル  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,6"
                Style="{StaticResource CaptionTextStyle}"
                Text="{x:Static p:Strings.FilesInClipboardLabel}" />

            <!--  ファイルツリー（コピーした項目が最上位）  -->
            <Border
                Grid.Row="3"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer
                    x:Name="TreeScrollViewer"
                    Padding="4"
                    VerticalScrollBarVisibility="Auto">
                    <TreeView
                        x:Name="FileTree"
                        BorderThickness="0"
                        ItemsSource="{Binding RootItems}"
                        PreviewMouseWheel="TreeView_PreviewMouseWheel"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="False">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox
                                        Margin="-5"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsThreeState="False" />
                                    <TextBlock
                                        Margin="2,1"
                                        VerticalAlignment="Center"
                                        FontWeight="{Binding IsDirectory, Converter={StaticResource BoolToFontWeightConverter}}"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!--  ボタン / プログレスバー  -->
            <Grid Grid.Row="4">
                <ProgressBar
                    Height="4"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="110"
                        Height="32"
                        Margin="0,0,8,0"
                        Command="{Binding PasteCommand}"
                        Content="{x:Static p:Strings.PasteButton}"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
                    <Button
                        MinWidth="110"
                        Height="32"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static p:Strings.CancelButton}"
                        IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
